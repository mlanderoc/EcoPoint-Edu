# Variables del frontend de EcoPoint Edu (copie este archivo a .env.local si las necesita).

# false: usa la API real de Spring Boot (spec 003) en vez de los datos simulados de MSW.
VITE_USE_MOCK_API=false

# Dirección del backend al que Vite reenvía /api en desarrollo (por defecto http://localhost:8080).
VITE_API_TARGET=http://localhost:8080
