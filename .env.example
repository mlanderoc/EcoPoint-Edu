# Variables de entorno de EcoPoint Edu (spec 002, R-051).
# Este archivo es solo una guía: NO pongas aquí tu contraseña ni lo renombres a .env.
# Defínelas en tu computador, una sola vez, desde PowerShell:
#
#   setx ECOPOINT_DB_PASSWORD "tu_contraseña_de_postgres"
#   setx ECOPOINT_DB_URL "jdbc:postgresql://localhost:5432/ecopoint"      (opcional)
#   setx ECOPOINT_DB_USER "postgres"                                       (opcional)
#
# Luego cierra y vuelve a abrir la terminal (o Orca) para que las vea.

# Base de desarrollo (con datos de demostración)
ECOPOINT_DB_URL=jdbc:postgresql://localhost:5432/ecopoint
ECOPOINT_DB_USER=postgres
ECOPOINT_DB_PASSWORD=

# Base de pruebas de integración (se recrea en cada ./mvnw verify)
ECOPOINT_TEST_DB_URL=jdbc:postgresql://localhost:5432/ecopoint_test

# API REST (spec 003)
# Origen del frontend permitido por CORS (por defecto el de Vite en desarrollo)
ECOPOINT_FRONTEND_ORIGIN=http://localhost:5173
# Carpeta local para las fotos de evidencia (no se sube al repositorio)
ECOPOINT_UPLOAD_DIR=./uploads
# true en producción, cuando el servidor use HTTPS
ECOPOINT_COOKIE_SECURE=false
# Perfil dev: activa Swagger UI en http://localhost:8080/swagger-ui.html
SPRING_PROFILES_ACTIVE=dev
